<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/rig_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rig_enable" />

        <TextView
            android:id="@+id/rig_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rig_intro"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/rig_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/rig_model"
                android:textSize="12sp" />

            <AutoCompleteTextView
                android:id="@+id/rig_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:hint="@string/rig_model_hint"
                android:imeOptions="actionDone"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/rig_device"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/rig_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/rig_baud"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/rig_baud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/rig_cat_ptt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/rig_cat_ptt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rig_key_up_delay" />

                <EditText
                    android:id="@+id/rig_delay"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:hint="@string/rig_key_up_delay" />
            </LinearLayout>

            <TextView
                android:id="@+id/rig_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/rig_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rig_connect" />

            <LinearLayout
                android:id="@+id/rig_connected_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rig_frequency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/rig_read"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rig_read" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/rig_set_frequency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/rig_frequency_hint"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <Button
                        android:id="@+id/rig_set"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rig_set" />
                </LinearLayout>

                <Button
                    android:id="@+id/rig_test_ptt"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rig_test_ptt" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
