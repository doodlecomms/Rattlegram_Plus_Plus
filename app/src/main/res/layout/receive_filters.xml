<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/filter_duplicates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_duplicates" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/filter_duplicates_hint"
            android:textColor="@color/tint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/filter_unencrypted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/filter_unencrypted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/filter_unencrypted_hint"
            android:textColor="@color/tint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/filter_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/filter_contacts" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/filter_contacts_hint"
            android:textColor="@color/tint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/filter_own_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/filter_own_call" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/filter_own_call_hint"
            android:textColor="@color/tint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/filter_note"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
