<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
	<!-- The remembered password is encrypted with a key that never leaves this phone; never back it up -->
	<cloud-backup>
		<exclude domain="sharedpref" path="password_store.xml"/>
		<!-- Message history (stored after decryption), contacts and call sign, and received pictures stay on this phone -->
		<!-- getPreferences() file: the full class name, since the app ID differs from the Java package -->
		<exclude domain="sharedpref" path="com.bi3bju.rattlegram_plus.MainActivity.xml"/>
		<exclude domain="sharedpref" path="MainActivity.xml"/>
		<exclude domain="file" path="pictures"/>
	</cloud-backup>
	<device-transfer>
		<exclude domain="sharedpref" path="password_store.xml"/>
		<!-- Message history (stored after decryption), contacts and call sign, and received pictures stay on this phone -->
		<!-- getPreferences() file: the full class name, since the app ID differs from the Java package -->
		<exclude domain="sharedpref" path="com.bi3bju.rattlegram_plus.MainActivity.xml"/>
		<exclude domain="sharedpref" path="MainActivity.xml"/>
		<exclude domain="file" path="pictures"/>
	</device-transfer>
</data-extraction-rules>